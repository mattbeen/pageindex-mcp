# Copy to .env and fill in values (compose loads this via env_file)
OPENAI_API_KEY=your_key_here
OPENAI_BASE_URL=http://your-litellm-host:8080/v1

# HTTP MCP bind — use 0.0.0.0 so clients can reach the server via your machine IP
# (not only 127.0.0.1 / localhost). Then connect to:
#   http://<YOUR_LAN_IP>:8765/mcp/page-index/v1
PAGEINDEX_MCP_HTTP_HOST=0.0.0.0
PAGEINDEX_MCP_HTTP_PORT=8765
PAGEINDEX_MCP_HTTP_PATH=/mcp/page-index/v1

# Optional host-side overrides used by docker-compose.yml
# PAGEINDEX_HOST_WORKSPACE=./workspace
# PAGEINDEX_HOST_CONFIG=./pageindex/config.yaml
# PAGEINDEX_HOST_UPLOADS=./uploads
